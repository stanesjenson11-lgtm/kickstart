# https://developers.cloudflare.com/workers/static-assets/headers
# Static files are served before the Worker runs, so next.config.ts headers()
# never sees them: the security headers are repeated here. The CSP stays in
# next.config.ts, with the HTML it governs.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# https://opennext.js.org/cloudflare/caching#static-assets-caching
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Pre-sized images from scripts/images.mjs. Their names carry no content hash,
# so a day fresh and then revalidated in the background, not immutable.
/_img/*
  Cache-Control: public,max-age=86400,stale-while-revalidate=2592000

# Everything else under public/ — the showreel, the raster sources, the icons —
# was being served with Cloudflare's default `max-age=0, must-revalidate`, so a
# returning visitor revalidated the whole lot on every load. A month fresh, then
# revalidated in the background; no content hash in the names, so not immutable.
#
# Matching rules COMBINE rather than override, and their values are joined with
# a comma, so no pattern below may also match /_img/* — everything there is
# .webp, which is why .webp is deliberately absent from this list.
/*.mp4
  Cache-Control: public,max-age=2592000,stale-while-revalidate=604800
/*.png
  Cache-Control: public,max-age=2592000,stale-while-revalidate=604800
/*.jpg
  Cache-Control: public,max-age=2592000,stale-while-revalidate=604800
/*.jpeg
  Cache-Control: public,max-age=2592000,stale-while-revalidate=604800
/*.svg
  Cache-Control: public,max-age=2592000,stale-while-revalidate=604800
/*.ico
  Cache-Control: public,max-age=2592000,stale-while-revalidate=604800
