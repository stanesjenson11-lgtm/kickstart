# Where project briefs are delivered. Both are required for the form to send;
# without them /api/brief returns 500 and the form shows its error state.
RESEND_API_KEY=re_xxxxxxxx
LEAD_TO_EMAIL=hello@kickstartcreative.studio

# Optional. Must be a domain verified in Resend. Falls back to Resend's
# onboarding sender, which only delivers to the account owner's address.
LEAD_FROM_EMAIL=Kickstart <briefs@kickstartcreative.studio>

# Cloudflare Turnstile (bot check on the brief form, switched by site.turnstile in
# lib/content.ts). Only the secret belongs here — the site key is public and lives
# in lib/content.ts, so a missed dashboard setting cannot ship an empty widget.
# Both must come from the SAME widget or every brief is rejected with a 403.
# On Cloudflare this is a Worker *Secret*, not a plain-text variable.
# NEVER put real values in this file — it is committed. Real values go in .env.local.
TURNSTILE_SECRET_KEY=0x0000000000000000000000000000000000
