# Where project briefs are delivered. Both are required for the form to send;
# without them /api/brief returns 500 and the form shows its error state.
RESEND_API_KEY=re_xxxxxxxx
LEAD_TO_EMAIL=hello@kickstartcreative.studio

# Optional. Must be a domain verified in Resend. Falls back to Resend's
# onboarding sender, which only delivers to the account owner's address.
LEAD_FROM_EMAIL=Kickstart <briefs@kickstartcreative.studio>

# Cloudflare Turnstile (bot check on the brief form). The site key is public and
# inlined at build time, so on Cloudflare it goes in the *build* variables.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x0000000000000000000000
TURNSTILE_SECRET_KEY=0x0000000000000000000000000000000000
